<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Qarro Live Translator"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="v0.5.8 • Internal Player • WEB PO Token • без захвата звука Android"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="YouTube-видео"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/videoUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Вставь ссылку YouTube или Поделиться → Qarro"
            android:inputType="textUri"
            android:singleLine="true" />

        <Button
            android:id="@+id/openVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▶ Получить и открыть видео" />

        <Button
            android:id="@+id/openViaProxy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="🌐 Открыть через публичный proxy"
            android:visibility="gone" />

        <TextView
            android:id="@+id/cookieStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="YouTube-сессия: не импортирована"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/importCookies"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Импортировать cookies.txt" />

            <Button
                android:id="@+id/clearCookies"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Удалить" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Если YouTube требует Sign in / «подтвердите, что вы не бот», приложение сначала пробует стандартный WEB PO Token через BotGuard. cookies.txt и публичный proxy остаются резервами."
            android:textSize="12sp" />

        <FrameLayout
            android:id="@+id/videoContainer"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="8dp"
            android:background="#000000"
            android:visibility="gone">

            <androidx.media3.ui.PlayerView
                android:id="@+id/playerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/internalSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="#99000000"
                android:gravity="center"
                android:padding="8dp"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/audioTapStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Внутренний PCM: ждёт воспроизведения"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Перевод"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/connectionGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/connectionDirect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="📱 Phone-Only — OpenAI напрямую с телефона" />

            <RadioButton
                android:id="@+id/connectionServer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🛠 Advanced Server — Multi-voice backend" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/directSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/apiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="OpenAI API key"
                android:inputType="textPassword"
                android:singleLine="true" />

            <Button
                android:id="@+id/saveApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Сохранить ключ на телефоне" />

            <TextView
                android:id="@+id/apiKeyStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="API key: не сохранён"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/serverSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/endpoint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="ws://127.0.0.1:8765/ws/translate"
                android:inputType="textUri"
                android:singleLine="true" />

            <Button
                android:id="@+id/testServer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Проверить сервер" />
        </LinearLayout>

        <EditText
            android:id="@+id/targetLanguage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Язык перевода"
            android:inputType="text"
            android:text="ru" />

        <RadioGroup
            android:id="@+id/modeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/modeLive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="⚡ Live — минимальная задержка" />

            <RadioButton
                android:id="@+id/modeMultiVoice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎭 Multi-voice — разные голоса + эмоции" />
        </RadioGroup>

        <TextView
            android:id="@+id/chunkLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Контекст Multi-voice: 6 сек" />

        <SeekBar
            android:id="@+id/chunkSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="9"
            android:progress="3" />

        <TextView
            android:id="@+id/modeHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phone-Only использует внутренний PCM плеера. Multi-voice пока требует Advanced Server."
            android:textSize="13sp" />

        <TextView
            android:id="@+id/volumeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Громкость русского голоса: 100%" />

        <SeekBar
            android:id="@+id/volumeSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="100" />

        <CheckBox
            android:id="@+id/duckOriginal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Приглушать оригинальную дорожку при переводе" />

        <CheckBox
            android:id="@+id/showSubtitles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Показывать русский текст внутри плеера" />

        <Button
            android:id="@+id/start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="▶ Начать перевод" />

        <Button
            android:id="@+id/stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="■ Остановить перевод" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Статус: вставь ссылку YouTube"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="v0.5.8 не запрашивает запись экрана или захват звука. Аудио для перевода берётся непосредственно из декодера встроенного Media3-плеера." />
    </LinearLayout>
</ScrollView>
