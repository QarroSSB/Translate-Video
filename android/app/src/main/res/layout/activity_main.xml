<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Qarro Live Translator"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="v0.4.1 • Phone-Only startup-safe"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Видео"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/videoUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Вставь ссылку YouTube или нажми Поделиться → Qarro"
            android:inputType="textUri"
            android:singleLine="true" />

        <Button
            android:id="@+id/openVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▶ Открыть видео в Qarro Translator" />

        <FrameLayout
            android:id="@+id/videoContainer"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Подключение перевода"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/connectionGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/connectionDirect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="📱 Phone-Only — без ПК, Termux и локального сервера" />

            <RadioButton
                android:id="@+id/connectionServer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🛠 Advanced Server — текущий Multi-voice backend" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/directSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/apiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="OpenAI API key"
                android:inputType="textPassword"
                android:singleLine="true" />

            <Button
                android:id="@+id/saveApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Сохранить ключ на телефоне" />

            <TextView
                android:id="@+id/apiKeyStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="API key: не сохранён"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/serverSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/endpoint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="ws://127.0.0.1:8765/ws/translate"
                android:inputType="textUri"
                android:singleLine="true" />

            <Button
                android:id="@+id/testServer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Проверить сервер" />
        </LinearLayout>

        <EditText
            android:id="@+id/targetLanguage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Язык перевода"
            android:inputType="text"
            android:text="ru" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Режим"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/modeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/modeLive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="⚡ Live — минимальная задержка" />

            <RadioButton
                android:id="@+id/modeMultiVoice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎭 Multi-voice — разные голоса + эмоции" />
        </RadioGroup>

        <TextView
            android:id="@+id/chunkLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Контекст Multi-voice: 6 сек" />

        <SeekBar
            android:id="@+id/chunkSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="9"
            android:progress="3" />

        <TextView
            android:id="@+id/modeHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phone-Only использует Live. Multi-voice пока доступен через Advanced Server."
            android:textSize="13sp" />

        <TextView
            android:id="@+id/volumeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Громкость русского голоса: 100%" />

        <SeekBar
            android:id="@+id/volumeSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="100" />

        <CheckBox
            android:id="@+id/duckOriginal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Приглушать оригинальный звук во время русского голоса" />

        <CheckBox
            android:id="@+id/showOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Показывать русские субтитры поверх видео" />

        <Button
            android:id="@+id/overlayPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Разрешить субтитры поверх приложений" />

        <Button
            android:id="@+id/start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="▶ Начать перевод" />

        <Button
            android:id="@+id/stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="■ Остановить" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Статус: готов"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Для теста: вставь ссылку, открой видео, сохрани API key, нажми «Начать перевод», разреши захват, затем запусти видео." />
    </LinearLayout>
</ScrollView>
