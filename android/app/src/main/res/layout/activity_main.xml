<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Qarro Live Translator"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="v0.3 • автоязык → русский дубляж + субтитры"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/endpoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:hint="ws://192.168.1.2:8765/ws/translate"
            android:inputType="textUri"
            android:singleLine="true" />

        <Button
            android:id="@+id/testServer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Проверить сервер" />

        <EditText
            android:id="@+id/targetLanguage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Язык перевода"
            android:inputType="text"
            android:text="ru" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Режим"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/modeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/modeLive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="⚡ Live — минимальная задержка" />

            <RadioButton
                android:id="@+id/modeMultiVoice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎭 Multi-voice — разные голоса + эмоции" />
        </RadioGroup>

        <TextView
            android:id="@+id/chunkLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Контекст Multi-voice: 6 сек" />

        <SeekBar
            android:id="@+id/chunkSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="9"
            android:progress="3" />

        <TextView
            android:id="@+id/modeHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Live переводит быстрее. Multi-voice требует несколько секунд для определения говорящих и эмоций. В обычном YouTube приложение не может автоматически задержать само видео."
            android:textSize="13sp" />

        <TextView
            android:id="@+id/volumeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Громкость русского голоса: 100%" />

        <SeekBar
            android:id="@+id/volumeSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="100" />

        <CheckBox
            android:id="@+id/duckOriginal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Просить Android приглушать оригинальный звук во время перевода" />

        <CheckBox
            android:id="@+id/showOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Показывать русские субтитры поверх YouTube" />

        <Button
            android:id="@+id/overlayPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Разрешить субтитры поверх приложений" />

        <Button
            android:id="@+id/start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="▶ Начать перевод" />

        <Button
            android:id="@+id/stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="■ Остановить" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Статус: готов"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Важно: Android может захватывать звук другого приложения только если это приложение разрешает Audio Playback Capture. Приглушение оригинала через Audio Focus также зависит от поведения приложения-источника." />
    </LinearLayout>
</ScrollView>
